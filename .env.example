# ─────────────────────────────────────────────────────────────────────────────
# Viewpoint Arena — environment variables
# ─────────────────────────────────────────────────────────────────────────────
#
# This file is the CREDENTIAL STORE.  The primary interface for configuring
# which connectors are active is viewpoint.config.ts (see
# viewpoint.config.example.ts for a template).  The config file references
# these variables by NAME; their VALUES live here and in the deployment's
# secret manager.
#
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  VITE_ PREFIX RULE
# ─────────────────────────────────────────────────────────────────────────────
#
# Any variable prefixed VITE_ is INLINED INTO THE CLIENT BUNDLE by Vite at
# build time and shipped to every browser that loads the app.  A secret in a
# VITE_ variable is a PUBLIC secret.
#
# The ONLY approved VITE_ variables in this project are:
#
#   VITE_SUPABASE_URL         — public Supabase project URL
#   VITE_SUPABASE_ANON_KEY    — public Supabase anon key (client-safe by
#                                design; access control is enforced by Postgres
#                                Row Level Security, not by key secrecy)
#
# Every other credential MUST use an unprefixed name and be read only in
# server-side code (api/* functions or capture-service).  The master config
# schema enforces this: it rejects VITE_-prefixed names on all fields except
# db.urlEnv and db.anonKeyEnv.
#
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.  Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────


# ── PLM — Onshape ────────────────────────────────────────────────────────────
# Onshape OAuth application credentials.
# Create an Onshape dev account at https://dev-portal.onshape.com/

# Server-only — Onshape OAuth client ID
ONSHAPE_CLIENT_ID=your_onshape_client_id

# Server-only — Onshape OAuth client secret
ONSHAPE_CLIENT_SECRET=your_onshape_client_secret


# ── PLM — Teamcenter (alternative to Onshape) ────────────────────────────────
# Siemens Teamcenter credentials.

# Server-only — Teamcenter service username
TC_USERNAME=your_teamcenter_username

# Server-only — Teamcenter service password
TC_PASSWORD=your_teamcenter_password


# ── TURN — Cloudflare ────────────────────────────────────────────────────────
# Cloudflare Calls TURN service for WebRTC relay.

# Server-only — TURN application token ID
CF_TURN_TOKEN_ID=your_cloudflare_turn_token_id

# Server-only — TURN API token (secret)
CF_TURN_API_TOKEN=your_cloudflare_turn_api_token


# ── TURN — self-hosted coturn (alternative to Cloudflare) ────────────────────

# Server-only — coturn shared secret (TURN REST API: use-auth-secret)
COTURN_SHARED_SECRET=your_coturn_shared_secret

# The IP coturn advertises in ICE candidates. Leave empty for a same-machine
# install. Set to the host's LAN IP under Docker Desktop so off-machine
# browsers can reach the relay.
TURN_EXTERNAL_IP=

# Relay port range (must match docker-compose.yml coturn service).
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Set to a non-empty value (e.g. 'yes') to allow the relay to forward to
# private IP ranges. Needed when both browsers are on 192.168.x and there is
# no public-route coturn. Leave empty for the default deny list.
#TURN_ALLOW_PRIVATE_PEERS=


# ── Database — Supabase ──────────────────────────────────────────────────────
# The bundled database (default): the compose stack runs supabase/postgres +
# PostgREST + Realtime, and nginx-proxy routes /rest/v1/ and /realtime/v1/
# from the same origin as the app. install.sh generates VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY automatically for this mode.
#
# For an external Supabase project, paste its URL and anon key instead.
# Both are VITE_-prefixed because the browser reads them directly. The anon
# key is client-safe by design — access control is enforced by Postgres RLS.

# PUBLIC (client bundle) — Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# PUBLIC (client bundle) — Supabase anon key (RLS-protected, not a secret)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key


# ── Database — JWT infrastructure (bundled mode) ─────────────────────────────
# These are generated by install.sh and preserved across re-runs. Changing
# JWT_SECRET invalidates every anon key already issued; changing
# REALTIME_DB_ENC_KEY makes encrypted Realtime rows unreadable.

# Server-only — HS256 secret for signing and verifying JWTs
JWT_SECRET=

# Server-only — Phoenix secret for Realtime's session encryption
SECRET_KEY_BASE=

# Server-only — AES-128 key for Realtime tenant data (EXACTLY 16 characters)
REALTIME_DB_ENC_KEY=

# Server-only — the anon key (same value as VITE_SUPABASE_ANON_KEY)
ANON_KEY=


# ── Access control (optional) ──────────────────────────────────────────────
# Two shared secrets that gate access to the app and its admin settings.
# Both are OPTIONAL and empty by default — an existing install behaves
# exactly as today (open) until the operator sets them via ./install.sh.
#
# These are SHARED passwords, not per-person accounts. Anyone with the
# password gets in; the app cannot tell one person from another. This is
# deliberate — see docs/plan/11-accounts-and-admin.md §M.
#
# Values are salted SHA-256 hashes: <16-hex-salt>:<64-hex-sha256(salt+pw)>.
# A colon, not a "$": Docker Compose eats an unescaped "$" in .env values.
# The plaintext passwords are never stored. Re-run ./install.sh to change.

# Server-only — salted hash of the front-door password (empty = open)
ACCESS_PASSWORD_HASH=

# Server-only — salted hash of the admin passphrase (empty = no admin screen)
ADMIN_PASSPHRASE_HASH=


# ── Identity — sign-in (optional) ────────────────────────────────────────────
# Read only when viewpoint.config.ts sets identity.mode to 'accounts' or 'sso'.
# That is also when install.sh puts `identity` in COMPOSE_PROFILES, which is
# what starts the bundled GoTrue service (docker-compose.yml `auth`, reached by
# browsers at /auth/v1/). A deployment on the default identity.mode 'none'
# reads none of the GoTrue variables below and runs no auth container at all.
# IDENTITY_MODE is the one exception, and it is written for every install: it
# is how the room server knows not to verify anything.
#
# The NAMES of the SSO credential variables come from the identity block of
# viewpoint.config.ts (identity.<provider>.clientIdEnv and .secretEnv); the
# pairs below are the names install.sh writes for each provider it offers.

# Which identity this deployment has, for the room server. It cannot read
# viewpoint.config.ts — room code runs inside workerd in the partykit container
# — so docker-compose.yml interpolates this value and
# deploy/partykit-entrypoint.sh hands it to the room server as --var.
#
# Set to 'accounts' or 'sso', the room server verifies the access token a
# signed-in browser sends with its presence and relays the name the ACCOUNT
# carries instead of the name that was typed, so a participant list, a
# transcript and an audit row all say who was really there. Set to 'none' — the
# default, and what install.sh writes when the answer was that nobody signs in
# — it strips the token and changes nothing else. Any other value is treated as
# identity being ON: a typo should cost an operator a room full of "(guest)"
# labels they come and ask about, not silently go back to trusting typed names.
#
# Verification uses JWT_SECRET from the database section above: the same secret
# GoTrue signs the token with and PostgREST and Realtime already check, so
# there is one trust boundary and no glue code. JWT_SECRET is server-only —
# there is deliberately no VITE_ spelling of it, and scripts/check-public-env.mjs
# fails the build if one ever appears.
#IDENTITY_MODE=none

# The absolute origin browsers use. GoTrue needs it to build its own redirect
# and callback URLs (GOTRUE_SITE_URL, API_EXTERNAL_URL, GOTRUE_URI_ALLOW_LIST),
# and it cannot derive it from the request: the app reaches it through
# nginx-proxy, so the Host header alone is not enough behind a non-443 port.
# install.sh writes it from the hostname and HTTPS_PORT answers, and it is the
# same value as publicUrl in viewpoint.config.ts.
#PUBLIC_URL=https://localhost

# true closes the sign-up form, so only accounts an admin creates can sign in.
# docker-compose.yml defaults it to false when unset. Deliberately left unset
# on an SSO install: a first sign-in from the provider is what creates the
# local account, and closing sign-up can close that door too.
#
# A note on empty values: GoTrue reads its environment with envconfig, which
# applies a default only when a variable is UNSET. One that is set but empty is
# parsed, and ParseBool("") fails, so an empty boolean crashes the container at
# boot instead of turning the feature off. docker-compose.yml therefore gives
# every GoTrue boolean an explicit true/false default — keep it that way.
#GOTRUE_DISABLE_SIGNUP=true

# Each provider is offered only when its own ENABLED flag is true; all three
# default to false in docker-compose.yml. install.sh writes the one you chose.
#GOTRUE_EXTERNAL_AZURE_ENABLED=true
#GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
#GOTRUE_EXTERNAL_KEYCLOAK_ENABLED=true

# Server-only — Microsoft Entra ID (Azure AD) app registration. Its redirect
# URI must be <PUBLIC_URL>/auth/v1/callback, or every sign-in fails with a
# redirect_uri mismatch.
#AZURE_CLIENT_ID=
#AZURE_CLIENT_SECRET=

# The tenant GoTrue sends people to, WITH its scheme — GoTrue appends
# /oauth2/v2.0/{authorize,token} to this value verbatim. Empty means
# Microsoft's multi-tenant 'common' endpoint, which accepts ANY work or school
# account rather than only this organisation's.
#AZURE_TENANT_URL=https://login.microsoftonline.com/<tenant-id>

# Server-only — Google OAuth client (Google Cloud console). No endpoint
# variable: GoTrue ignores GOTRUE_EXTERNAL_GOOGLE_URL and resolves through OIDC
# discovery against Google's fixed issuer.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Server-only — Keycloak client, or any other OpenID Connect provider
#KEYCLOAK_CLIENT_ID=
#KEYCLOAK_CLIENT_SECRET=

# The REALM url, not the server url: GoTrue appends
# /protocol/openid-connect/{auth,token,userinfo} to it and refuses to start the
# flow when it is empty. This is the value viewpoint.config.ts carries as
# identity.keycloak.realmUrl; it is repeated here because docker-compose.yml
# reads .env, not the TypeScript config.
#KEYCLOAK_REALM_URL=https://keycloak.acme.com/realms/acme

# Server-only — SAML 2.0, and off unless BOTH are set. A SAML provider is not a
# client id/secret pair: it is an IdP metadata document registered through the
# GoTrue admin API, which stores it in auth.saml_providers. The private key is
# standard (not URL-safe) base64 of a PKCS#1 DER RSA key, exponent 65537, at
# least 2048 bits. SAML is the one provider GoTrue validates AT BOOT, so
# enabling it with an unusable key is a fatal configuration error rather than a
# feature that stays unused.
#GOTRUE_SAML_ENABLED=
#GOTRUE_SAML_PRIVATE_KEY=


# ── AI Capture — cloud LLM providers ─────────────────────────────────────────
# Only needed when viewpoint.config.ts sets capture.provider to 'openai' or
# 'anthropic'.  The browser never sees these: api/capture/extract.ts reads them
# from server-side process.env and proxies the call.  The default capture
# provider ('mock') needs no key at all, and 'ollamaDirect' deliberately has
# none — that mode talks to a LAN Ollama instance and nothing leaves the
# network.
#
# The variable NAME each provider reads comes from capture.apiKeyEnv in
# viewpoint.config.ts; the two below are the defaults used when the config
# does not name one.

# Server-only — OpenAI API key
OPENAI_API_KEY=your_openai_api_key

# Server-only — Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key


# ── Notifications — Microsoft Teams ──────────────────────────────────────────
# Incoming webhook URL for Teams channel notifications.

# Server-only — Teams incoming webhook URL (bearer credential)
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/...


# ── Model file storage — Supabase Storage (optional) ─────────────────────────
# Imported 3D model files are content-addressed: a file is stored under its own
# SHA-256 and every part of the app (the room socket, a curated review, the URL
# that serves it) refers to that hash rather than to the bytes.
#
# The DEFAULT install needs NOTHING here. `modelStorage` is absent from the
# config install.sh writes, which means the `local` provider writing to
# /data/models — the `models-data` volume docker-compose.yml mounts on the api
# service.
#
# Only a hosted deployment with no volume to write to (Vercel + Supabase cloud)
# switches the provider, in viewpoint.config.ts:
#
#   modelStorage: {
#     provider: 'supabase',
#     bucket: 'review-models',
#     serviceRoleKeyEnv: 'MODEL_STORAGE_SERVICE_ROLE_KEY',
#   },
#
# The bucket is reached over the Storage REST API at SUPABASE_URL, or at
# VITE_SUPABASE_URL when that is not set — neither is named in the config
# because every Supabase deployment already has one of them.

# Server-only — Supabase SERVICE-ROLE key. This bypasses Row Level Security
# entirely and is read by the api container alone. It must never carry a VITE_
# prefix: the config schema refuses one, because a VITE_ variable is inlined
# into the bundle every visitor downloads.
#MODEL_STORAGE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# ── Master config as JSON (Vercel / serverless) ──────────────────────────────
# Vercel and other hosts without a config file: the output of `npm run config:json`.
#VIEWPOINT_CONFIG=


# ── Backups (docker-compose installs) ────────────────────────────────────────
# The db-backup service dumps the database and archives the model files into the
# db-backups volume every BACKUP_INTERVAL_HOURS hours, keeping the newest BACKUP_KEEP.
# Restore with deploy/backup/restore.sh <file> --yes (docs/INSTALL.md).
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
BACKUP_MODELS=true
