# ─────────────────────────────────────────────────────────────────────────────
# capture-service — environment variables (template)
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy to `.env` and edit. Every value below is the DEFAULT, so a stock local
# install needs no edits at all — this file is here to document the names.
#
# ⚠️  The service reads os.environ. It does NOT auto-load this file.
#     Either export the values, or let uvicorn load them:
#
#       uvicorn capture_service.main:app --env-file .env --host 127.0.0.1 --port 8080
#
#     …or in a shell:  set -a; . ./.env; set +a
#     In docker-compose: env_file: ./capture-service/.env  (T5.1)
#
# ⚠️  No VITE_ prefix, ever. VITE_-prefixed variables are inlined into the
#     browser bundle by Vite at build time — see scripts/check-public-env.mjs.
#     Nothing here is a secret (Ollama and faster-whisper are unauthenticated
#     local components), but the naming rule still applies.
#
# Full descriptions: capture-service/README.md §2 "Configuration".
# ─────────────────────────────────────────────────────────────────────────────

# ── Transcription (faster-whisper, batch) ────────────────────────────────────
# Model size, or a path to a local CTranslate2 model directory for an
# air-gapped install. Downloaded from huggingface.co on first use.
CAPTURE_WHISPER_MODEL=base.en

# auto | cpu | cuda
CAPTURE_WHISPER_DEVICE=cpu

# default | auto | int8 | int8_float16 | float16 | float32  (float16 on a GPU)
CAPTURE_WHISPER_COMPUTE_TYPE=int8

# Language hint (e.g. en, de). Empty = auto-detect.
CAPTURE_WHISPER_LANGUAGE=

# ── Extraction (Ollama) ──────────────────────────────────────────────────────
# The Ollama ROOT: scheme + host + port, no path (/api/chat is appended),
# no username or password. Must be reachable FROM THIS SERVICE.
CAPTURE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Must already be pulled on that instance: `ollama pull qwen2.5:7b`.
# Alternates from docs/local-capture-plan.md: qwen2.5:7b-instruct,
# llama3.1:8b-instruct.
CAPTURE_OLLAMA_MODEL=qwen2.5:7b

# Per-request timeout. A 7B model on CPU takes 5-10s per extraction and much
# longer while it cold-loads into RAM.
CAPTURE_TIMEOUT_SECONDS=120

# ── Limits ───────────────────────────────────────────────────────────────────
# Hard ceiling on one uploaded recording, in bytes (no suffixes: write
# 209715200, not 200MB). 200 MiB ≈ four hours of Opus/WebM.
CAPTURE_MAX_UPLOAD_BYTES=209715200

# ── Serving (`python -m capture_service`) ────────────────────────────────────
# 127.0.0.1 keeps a laptop run private. A container sets 0.0.0.0.
CAPTURE_HOST=127.0.0.1
CAPTURE_PORT=8080
