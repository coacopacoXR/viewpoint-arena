# ─────────────────────────────────────────────────────────────────────────────
# convert-service — environment variables (template)
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy to `.env` and edit. Every value below is the DEFAULT, so a stock local
# install needs no edits at all — this file is here to document the names.
#
# ⚠️  The service reads os.environ. It does NOT auto-load this file.
#     Either export the values, or let uvicorn load them:
#
#       uvicorn convert_service.main:app --env-file .env --host 127.0.0.1 --port 8080
#
#     …or in a shell:  set -a; . ./.env; set +a
#     In docker-compose the variables are passed explicitly, with the repo-root
#     .env as the source — see the convert-service block in docker-compose.yml.
#
# ⚠️  No VITE_ prefix, ever. VITE_-prefixed variables are inlined into the
#     browser bundle by Vite at build time — see scripts/check-public-env.mjs.
#     CONVERT_SHARED_SECRET is a real secret, so it must never carry one.
#
# Full descriptions: convert-service/README.md §2 "Configuration".
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication ───────────────────────────────────────────────────────────
# Bearer token required on EVERY route, sent as `X-Convert-Token` or
# `Authorization: Bearer …`. EMPTY MEANS OFF, which is only acceptable because
# the service then binds 127.0.0.1 and docker-compose publishes no port for it.
# Generate one with:  openssl rand -hex 32      (install.sh does this for you)
CONVERT_SHARED_SECRET=

# ── Limits ───────────────────────────────────────────────────────────────────
# Hard ceiling on one uploaded model, in bytes (no suffixes: write 209715200,
# not 200MB). 200 MiB is the same ceiling the app puts on a model file
# (MAX_MODEL_FILE_BYTES in utils/modelFormats.ts), enforced while the body
# streams so an oversized assembly is refused before any kernel time is spent.
CONVERT_MAX_UPLOAD_BYTES=209715200

# Wall clock for ONE REQUEST — queueing included — after which the job's
# subprocess is killed and the caller gets a 504. The browser path gives up after
# three minutes because a person is waiting; this is queued and done once for
# everybody, so it is worth more patience.
CONVERT_TIMEOUT_S=900

# Conversions running at once. Extra requests QUEUE rather than fail. Tessellation
# holds roughly six times the file size in memory, so raise this only together
# with the container's CONVERT_MEM_LIMIT in docker-compose.yml.
CONVERT_CONCURRENCY=1

# ── The engine ───────────────────────────────────────────────────────────────
# gltfpack executable: a path, or a name to look up on PATH. The Dockerfile
# installs the pinned meshoptimizer release binary at /usr/local/bin/gltfpack.
CONVERT_GLTFPACK=gltfpack

# ── Serving (`python -m convert_service`) ────────────────────────────────────
# 127.0.0.1 keeps a laptop run private. A container sets 0.0.0.0.
CONVERT_HOST=127.0.0.1
CONVERT_PORT=8080

# ── Not read by this service ─────────────────────────────────────────────────
# docker-compose.yml interpolates these into the container's resource limits.
# They are documented here so the whole CONVERT_ surface is in one place.
# CONVERT_MEM_LIMIT=6g
# CONVERT_CPUS=4
